[Unit]
Description=k-skill hrfco relay (api.hrfco.go.kr blocks Google Cloud egress)
After=network-online.target
Wants=network-online.target
# App dir lives on the gpu02:/data NFS mount.
RequiresMountsFor=/data/home/jeffrey/apps/k-skill-hrfco-relay
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/data/home/jeffrey/apps/k-skill-hrfco-relay
EnvironmentFile=/data/home/jeffrey/apps/k-skill-hrfco-relay/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
